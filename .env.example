# Interview Playbook -- environment configuration
#
# Copy this file to `.env` (never commit `.env`) and fill in real values
# when you have them. Both variables below are read at build time via
# Expo's EXPO_PUBLIC_* convention, so they are inlined into the JS bundle
# -- do not put secret/server-only values here, only the public
# RevenueCat SDK key.

# The RevenueCat public SDK API key (iOS or Android) for this app, from
# app-specific RevenueCat > Project settings > API keys.
# Leave this EMPTY to run the app in MOCK MODE: purchases are simulated
# locally (AsyncStorage-backed) with no RevenueCat account or network
# calls at all. See lib/purchases.ts.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Set to "true" to force mock purchases even if a real API key above is
# set (useful for demoing/screenshotting the paywall without spending a
# real sandbox purchase). Any other value (or unset) means "don't force
# mock mode" -- mode is then decided purely by whether the key above is
# present.
EXPO_PUBLIC_MOCK_PURCHASES=false
